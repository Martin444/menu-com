# Copy this file to .env and adjust values for local development.
# Vite only exposes env vars prefixed with VITE_ to the client.

# Public Catalog API base URL
VITE_API_URL=https://menucom-api-production.up.railway.app

# Public site URL used for canonical links and OG images
VITE_SITE_URL=https://menucom.netlify.app
